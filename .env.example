# ---------------------------------------------------------------------------
# PRSME — Supabase configuration (Phase 5)
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` in the project root and fill in the values.
#
#     cp .env.example .env.local
#
# `.env.local` is git-ignored. Never commit real credentials.
#
# Everything in PRSME works WITHOUT this file: the demo profile at /u/noir,
# the Studio, and every existing test run with no Supabase project at all.
# These two variables only switch the account features on.
# ---------------------------------------------------------------------------

# Your project URL. Project Settings -> API -> Project URL.
# Use the Publishable key (not the legacy anon key and never the service-role key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your publishable key. Project Settings -> API -> Publishable key.
#
# The `sb_publishable_...` form is the current one; older projects still show a
# JWT-shaped `anon` key, which is also accepted here.
#
# This value is inlined into the browser bundle by Next.js, which is exactly why
# it must be the publishable key. A service-role key bypasses Row Level Security
# entirely and must never appear in application code or client configuration.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ---------------------------------------------------------------------------
# Where to apply the schema
# ---------------------------------------------------------------------------
# Run the files in supabase/migrations/ in filename order. Either:
#
#   npx supabase link --project-ref <your-project-ref>
#   npx supabase db push
#
# or paste each file into the Supabase SQL editor. They are idempotent, so a
# re-run is safe.
#
#   20250101000001_profiles.sql    the profiles table, one per account
#   20250101000002_profiles_rls.sql Row Level Security policies
#   20250101000003_avatars.sql     the private avatars bucket + policies
#
# After applying, confirm access control in the dashboard:
#   Authentication -> Providers -> Email
#     - "Confirm email" ON means a new user must click the emailed link first.
#   Authentication -> URL Configuration
#     - Site URL: http://localhost:3000
#     - Redirect URLs: http://localhost:3000/auth/callback
#                          http://localhost:3000/**
# ---------------------------------------------------------------------------