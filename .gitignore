# deps / build output
node_modules
.next
out
.turbo

# env
.env*
!.env.example

# editor / os
.DS_Store
Thumbs.db

# typescript incremental cache
tsconfig.tsbuildinfo

# --- PRSME local dev + verification scratch ---
# Everything below is generated by running `npm run dev`/`start`, the browser
# probe scripts, or a local `next start`. None of it belongs in the repo.

# log files
*.log
.pnpm-debug.log*

# next start / dev redirected output (scripts/start-server.ps1 writes these)
server.out.txt
server.err.txt

# browser automation profile + cdp logs (scripts/cdp.mjs, launch scripts)
.edge-userdata-*/
.edge-cdp-*.log
.edge-cdp-*.log.err

# one-off probe artifacts emitted at the repo root by the browser scripts
/p24-*.html
/phase3-quick-probe.mjs
/probe-overflow.mjs

# transient per-phase captures that are NOT the committed reference set
# (docs/screenshots/<phase>/ is the reference set and stays tracked)
/docs/phase2*.png
/docs/phase3*.png
/docs/phase3*.html
/docs/phase3*.json

# probe/assert pages placed under public/ by the browser scripts
/public/phase*-assert.html
/public/phase*-probe*.html
/public/phase3-overflow-debug.html

# ad-hoc capture output text files (cap-*.txt, *-out.txt, st-meta*.txt, ...)
/cap-*.txt
/*-out.txt
/*.out.txt
/*.err.txt
/st-meta*.txt
/ver-persist.txt
/browser-checks.txt

# free-form scratch output written by the phase scripts
/artifacts/

# one-off debugging probes kept only while a phase was being chased down;
# none are wired into package.json, so they are not project code
/scripts/debug-*.mjs
/scripts/find-source.mjs
/scripts/probe-profile.mjs
/scripts/rail-scroll-probe.mjs
/scripts/t5-probe.mjs
/scripts/t5-replay.mjs
/scripts/run-server.mjs