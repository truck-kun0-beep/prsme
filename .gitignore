# deps / build output
node_modules
.next
out
.turbo

# env
.env*
!.env.example

# editor / os
.DS_Store
Thumbs.db

# typescript incremental cache
tsconfig.tsbuildinfo

# --- PRSME local dev + verification scratch ---
# Everything below is generated by running `npm run dev`/`start`, the browser
# probe scripts, or a local `next start`. None of it belongs in the repo.

# log files
*.log
.pnpm-debug.log*

# next start / dev redirected output (scripts/start-server.ps1 writes these)
server.out.txt
server.err.txt

# browser automation profile + cdp logs (scripts/cdp.mjs, launch scripts)
.edge-userdata-*/
.edge-cdp-*.log
.edge-cdp-*.log.err

# one-off probe artifacts emitted at the repo root by the browser scripts
/p24-*.html
/phase3-quick-probe.mjs
/probe-overflow.mjs

# transient per-phase captures that are NOT the committed reference set
# (docs/screenshots/<phase>/ is the reference set and stays tracked)
/docs/phase2*.png
/docs/phase3*.png
/docs/phase3*.html
/docs/phase3*.json

# probe/assert pages placed under public/ by the browser scripts
/public/phase*-assert.html
/public/phase*-probe*.html
/public/phase3-overflow-debug.html

# ad-hoc capture output text files (cap-*.txt, *-out.txt, st-meta*.txt, ...)
/cap-*.txt
/*-out.txt
/*.out.txt
/*.err.txt
/st-meta*.txt
/ver-persist.txt
/browser-checks.txt

# free-form scratch output written by the phase scripts
/artifacts/

# one-off shell scratch: a pasted command's output and a file listing
/env-check.txt
/tree.txt

# one-off debugging probes kept only while a phase was being chased down;
# none are wired into package.json, so they are not project code
/scripts/debug-*.mjs
/scripts/find-source.mjs
/scripts/probe-profile.mjs
/scripts/rail-scroll-probe.mjs
/scripts/t5-probe.mjs
/scripts/t5-replay.mjs
/scripts/run-server.mjs

# --- PRSME local database stack (scripts/localdb) ---
# The stack runs a real Postgres, a real PostgREST and a local auth service
# on this machine. Everything they generate is disposable: the data
# directory, the toolchain binaries, the logs, and the generated env file.

# the cluster's data directory, the generated env file, and the service logs
/.tmp-localdb/

# the PostgREST binary and the libpq/OpenSSL/ICU runtime it links against
/.tmp-tools/

# the schema dump the PostgREST probe writes
/.tmp-localdbopenapi.json

# --- Supabase CLI local state ---
# `supabase link` writes the linked project's ref, its pooler URL and the
# remote version stamps into supabase/.temp/. That is machine state, and a
# stale link silently points `supabase db push` at whatever project was
# linked last, so it must never be committed.
supabase/.temp/

# the PRSME project's database password, read by scripts/remote-db.mjs.
# Git-ignored like every other credential in this repository.
.env.local.db-password

# --- PRSME one-off database diagnostics (scripts/localdb) ---
# The probes written to answer a single question while a phase was being
# chased down. Each one prints the state of the database at the moment it
# was run, which is not useful to anyone else and is misleading once the
# question has been answered.
#
# The tooling that is NOT here is the tooling worth keeping: the shared
# splitter, the local runner, and the checks that assert a property
# (check-splitter, probe-anon-rpc, reset-migration).
/scripts/localdb/probe-acl-path.mjs
/scripts/localdb/probe-acl.mjs
/scripts/localdb/probe-anon-functions.mjs
/scripts/localdb/probe-claims.mjs
/scripts/localdb/probe-craft.mjs
/scripts/localdb/probe-default-db.mjs
/scripts/localdb/probe-default-owner.mjs
/scripts/localdb/probe-default-privs.mjs
/scripts/localdb/probe-dollar.mjs
/scripts/localdb/probe-remote-endpoints.mjs
/scripts/localdb/probe-remote-migrations.mjs
/scripts/localdb/debug-split.mjs
/scripts/localdb/dump-units.mjs
/scripts/localdb/list-units.mjs
/scripts/localdb/show-lines.mjs
/scripts/localdb/show-unit.mjs
/scripts/localdb/summary-units.mjs
/scripts/localdb/units-dump.txt
/scripts/localdb/block-trigger.txt
